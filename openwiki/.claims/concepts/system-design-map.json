    {
      "id": "claim_14d47c1b320149bcb25f97003fae6681",
      "statement": "Caching is primarily a read-load mechanism with update-pattern trade-offs: cache-aside can return stale data, write-through synchronously persists writes, and write-behind asynchronously flushes writes and risks losing data not yet flushed when the cache fails.",
      "evidence": [
        {
          "resource": "repo://concepts/system-design/caching-strategies.md#L39-L44",
          "version": "repo-lines-v1:sha256:7e3c0fe0ee84f63491efdaeb81278be02eb55b843f6fe93a4aeb1fc11f34f74e:"
