        }
      ]
    },
    {
      "id": "claim_3aa4fdd352ea45278f7283754bf2d17f",
      "statement": "Replication copies a dataset for read scaling and failover, whereas sharding partitions rows across independent instances when data size or write volume outgrows a single database; an OLTP/OLAP split instead assigns transactional and analytical workloads to different stores.",
      "evidence": [
        {
