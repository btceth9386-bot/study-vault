    {
      "id": "claim_f538837aece94e54adc5dc036d85788d",
      "statement": "A Collector pipeline is a named, signal-specific route in which receivers accept telemetry, optional processors modify it, and exporters send it to one or more destinations, allowing operational routing changes without application instrumentation changes.",
