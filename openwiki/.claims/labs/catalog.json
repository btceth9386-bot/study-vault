    {
      "id": "claim_97f1ad45a3c74250b51e16ca2c4530ef",
      "statement": "Kiro usage accounting is hook-based: the `Stop` hook invokes the usage logger, and the run evaluator reads JSON snapshots to return a `credits_logged` count and summed credit metadata; an eight-item healthy run is expected to have eight task-side snapshots because judge calls do not use Kiro CLI.",
      "evidence": [
        {
          "resource": "repo://labs/kiro-langfuse-eval/scripts/lib/langfuse_glue.py#L123-L161",
          "version": "repo-lines-v1:sha256:c151c1e5d0a1ebffdb7e0a6883f08aa46bbd3d26a90ec1ffafd42c7fadfc8b18:"
