# Copy to .env and fill in real values. Never commit the filled-in .env.

# Kiro CLI — https://github.com/openabdev/openab/blob/main/docs/kiro.md
KIRO_API_KEY=

# Judge provider — must NOT be the same model family as whatever Kiro CLI
# runs the task with. Pick whichever of these you actually hold credentials
# for (scripts/lib/judge_client.py dispatches on JUDGE_PROVIDER):
JUDGE_PROVIDER=
# one of: anthropic | openai | gemini
JUDGE_API_KEY=
# JUDGE_MODEL=              # optional; each provider has a sane default

# Langfuse project keys (Project Settings > API Keys in the Langfuse UI).
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
# In-cluster Langfuse web service (see spec.md prerequisites for how this
# was confirmed reachable). Use your own LANGFUSE_HOST if running outside
# this cluster, e.g. https://cloud.langfuse.com.
LANGFUSE_BASE_URL=http://langfuse-web.langfuse.svc.cluster.local:3000

# Optional override; defaults to <lab-dir>/usage-log.jsonl.
# KIRO_USAGE_LOG=
